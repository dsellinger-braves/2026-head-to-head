# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Discord Bot & Google Gemini Configuration
DISCORD_BOT_TOKEN=your-discord-bot-token
GEMINI_API_KEY=your-gemini-api-key

# ESPN Fantasy API Credentials (if private league)
ESPN_S2=your-espn-s2-cookie
ESPN_SWID=your-espn-swid-cookie

# Google Cloud Storage (for stat backups if applicable)
GCS_BUCKET_NAME=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS_JSON=your-gcs-service-account-json
